// ============================================
// PART 4: DOM INTERACTIONS
// ============================================

// DOM elements for Part 4
const textInput = document.getElementById('textInput');
const colorSelect = document.getElementById('colorSelect');
const updateTextBtn = document.getElementById('updateTextBtn');
const changeBgColorBtn = document.getElementById('changeBgColorBtn');
const addItemBtn = document.getElementById('addItemBtn');
const resetBtn = document.getElementById('resetBtn');
const displayText = document.getElementById('displayText');
const itemList = document.getElementById('itemList');
const part4Output = document.getElementById('part4Output');

// DOM Interaction 1: Updating text content
updateTextBtn.addEventListener('click', function() {
    // Check if input is not empty
    if (textInput.value.trim() !== "") {
        displayText.textContent = textInput.value;
    } else {
        displayText.textContent = "Please enter some text first!";
    }
});

// DOM Interaction 2: Changing element styles
changeBgColorBtn.addEventListener('click', function() {
    const selectedColor = colorSelect.value;
    displayText.style.color = selectedColor;
    
    // Update text to reflect color change
    displayText.textContent = `This text is now ${selectedColor}!`;
});

// DOM Interaction 3: Creating and adding new elements
addItemBtn.addEventListener('click', function() {
    // Create new list item element
    const newItem = document.createElement('li');
    const itemNumber = itemList.children.length + 1;
    newItem.textContent = `New item ${itemNumber} added via DOM`;
    
    // Add the new element to the list
    itemList.appendChild(newItem);
});

// Reset all DOM changes
resetBtn.addEventListener('click', function() {
    // Reset text content and styles
    displayText.textContent = "This text will be updated based on your input.";
    displayText.style.color = "black";
    textInput.value = "";
    colorSelect.value = "black";
    
    // Remove dynamically added list items
    while (itemList.children.length > 2) {
        itemList.removeChild(itemList.lastChild);
    }
});

